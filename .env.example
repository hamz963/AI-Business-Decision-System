# =============================================================================
# AI-BDSS — Environment Configuration (100% Free-Tier & Local OpenCode Ready)
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------
# REQUIRED — Security
# ---------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY

# ---------------------------------
# Database (SQLite default, switch to PostgreSQL for production)
# ---------------------------------
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/aibdss

# ---------------------------------
# Free-Tier AI Models & Model Switching
# Default model: gemini-2.5-flash
# Options: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-3.1-flash-lite, qwen3:0.6b, rule_based
# ---------------------------------
ACTIVE_AI_MODEL=gemini-2.5-flash

# Google Free Tier API Key (used by OpenCode and backend)
GOOGLE_API_KEY=your_google_free_api_key_here

# Local Offline Ollama (zero tokens, 100% private)
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------
# Upload limits
# ---------------------------------
MAX_UPLOAD_BYTES=104857600  # 100 MB default

# ---------------------------------
# CORS (add your frontend URL if different from defaults)
# ---------------------------------
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
